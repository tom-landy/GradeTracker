<%- include('partials/head', { pageTitle: 'Admin' }) %>
<header class="topbar">
  <div class="container row between">
    <strong>GradeTracker</strong>
    <nav class="row gap">
      <a href="/admin">Students</a>
      <a href="/admin/overview">Overview</a>
      <a href="/admin/units">Units &amp; criteria</a>
      <form method="post" action="/admin/logout"><button class="btn link">Sign out</button></form>
    </nav>
  </div>
</header>

<main class="container">
  <h1><%= title %></h1>
  <p class="muted">Tracking <%= totalCriteria %> criteria across <%= tree.length %> units.</p>

  <section class="card">
    <h2>Add a student</h2>
    <form method="post" action="/admin/students" class="row gap wrap">
      <input type="text" name="name" placeholder="Student name" required />
      <button type="submit" class="btn primary">Add student</button>
    </form>
  </section>

  <section class="card">
    <h2>Import / export (CSV)</h2>
    <p class="muted small">
      Upload a spreadsheet of students and their progress. Easiest way: download
      the CSV below (it includes every criterion as a column and any existing
      students), fill in an <strong>x</strong> where a criterion is complete,
      then upload it back. Students are matched by name or created automatically.
    </p>
    <p><a class="btn small" href="/admin/export.csv">⬇ Download CSV (template &amp; backup)</a></p>

    <form method="post" action="/admin/import" data-import-form>
      <label for="csvfile">Upload a CSV file</label>
      <input type="file" id="csvfile" accept=".csv,text/csv" />
      <details class="mt">
        <summary class="muted small">…or paste CSV text</summary>
        <textarea name="csv" id="csvtext" rows="6" placeholder="Student,Unit 1 | P1,Unit 1 | P2,...&#10;Alice,x,,..."></textarea>
      </details>
      <div class="mt"><button type="submit" class="btn primary">Import CSV</button></div>
    </form>

    <hr class="sep" />

    <h3>Sync from the cloud</h3>
    <% if (syncConfigured) { %>
      <p class="muted small">Pull the latest workbook from <strong><%= syncSource %></strong> and re-import it.</p>
      <form method="post" action="/admin/sync"
            onsubmit="this.querySelector('button').disabled=true;this.querySelector('button').textContent='Syncing…';">
        <button type="submit" class="btn primary">⟳ Sync now</button>
      </form>
    <% } else { %>
      <p class="muted small">Cloud sync isn't set up yet. Add a OneDrive/SharePoint source
        (see the README "Cloud sync" section) to enable a one-click <strong>Sync now</strong> button here.</p>
    <% } %>

    <hr class="sep" />

    <h3>Upload an Excel workbook (.xlsx)</h3>
    <p class="muted small">
      Upload your whole mark book. Every tab named for a unit (e.g.
      <code>Unit 8</code> or <code>U1 A123</code>) with a criteria row
      (P1, P2, …) is read; units and criteria are built from the sheet, and
      students are matched by name across tabs. Grade/summary-only tabs are
      skipped. <code>y</code> = complete; <code>n</code>/<code>U</code>/blank = outstanding.
    </p>
    <form method="post" action="/admin/import-xlsx" enctype="multipart/form-data">
      <input type="file" name="file" accept=".xlsx" required />
      <div class="mt"><button type="submit" class="btn primary">Import workbook</button></div>
    </form>
  </section>

  <section>
    <h2>Students</h2>
    <% if (unverifiedCount > 0) { %>
      <div class="card" style="border-color:#fca5a5">
        <p class="small"><strong><%= unverifiedCount %></strong> student<%= unverifiedCount === 1 ? '' : 's' %>
          without a student number (unverified / withdrawn). Per policy these shouldn't be on the system.</p>
        <form method="post" action="/admin/remove-unverified"
              onsubmit="return confirm('Remove <%= unverifiedCount %> student(s) without a number? This cannot be undone.')">
          <button class="btn small danger">Remove students without a number</button>
        </form>
      </div>
    <% } %>
    <% if (students.length === 0) { %>
      <p class="muted">No students yet. Add one above to start tracking and to generate a shareable link.</p>
    <% } %>
    <div class="student-list">
      <% students.forEach(function (s) { %>
        <div class="card student-row">
          <div class="grow">
            <div class="row between">
              <a class="student-name" href="/admin/students/<%= s.id %>"><%= publicLabel(s) %></a>
              <span class="badge"><%= s.summary.done %>/<%= s.summary.total %> done</span>
            </div>
            <div class="bar"><span style="width: <%= s.summary.pct %>%"></span></div>
            <div class="row gap wrap link-row">
              <input class="share-link" type="text" readonly
                     value="<%= baseUrl %>/s/<%= s.token %>"
                     onclick="this.select()" />
              <button type="button" class="btn small" data-copy="<%= baseUrl %>/s/<%= s.token %>">Copy link</button>
              <a class="btn small" href="/s/<%= s.token %>" target="_blank" rel="noopener">Open</a>
              <a class="btn small" href="/admin/students/<%= s.id %>">Mark work</a>
              <form method="post" action="/admin/students/<%= s.id %>/delete"
                    onsubmit="return confirm('Delete <%= publicLabel(s) %>? This cannot be undone.')">
                <button class="btn small danger">Delete</button>
              </form>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </section>

  <section class="card danger-zone">
    <h2>Danger zone — clear all data</h2>
    <p class="muted small">Permanently deletes every unit, criterion, student and
      all progress, leaving an empty dataset ready for a fresh import. This cannot
      be undone. Type <code>DELETE</code> to confirm.</p>
    <form method="post" action="/admin/reset" class="row gap wrap"
          onsubmit="return confirm('Clear ALL data? This cannot be undone.')">
      <input type="text" name="confirm" placeholder="Type DELETE" />
      <button type="submit" class="btn small danger">Clear all data</button>
    </form>
  </section>
</main>

<script src="/static/app.js"></script>
<%- include('partials/foot') %>
