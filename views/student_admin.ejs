<%- include('partials/head', { pageTitle: 'Mark · ' + fullName(student) }) %>
<header class="topbar">
  <div class="container row between">
    <strong>GradeTracker</strong>
    <nav class="row gap">
      <a href="/admin">Students</a>
      <a href="/admin/overview">Overview</a>
      <a href="/admin/units">Units &amp; criteria</a>
      <form method="post" action="/admin/logout"><button class="btn link">Sign out</button></form>
    </nav>
  </div>
</header>

<main class="container" data-student-id="<%= student.id %>">
  <p class="muted"><a href="/admin">&larr; All students</a></p>
  <h1>Mark work — <%= publicLabel(student) %></h1>

  <div class="row between wrap card">
    <div class="grow">
      <div class="row between">
        <span><strong id="count"><%= summary.done %></strong> / <%= summary.total %> criteria complete</span>
        <span class="badge" id="pct"><%= summary.pct %>%</span>
      </div>
      <div class="bar"><span id="bar" style="width: <%= summary.pct %>%"></span></div>
    </div>
  </div>

  <p class="muted">Click a criterion to toggle it between <span class="legend outstanding">outstanding</span>
    and <span class="legend complete">complete</span>. Changes save automatically.</p>

  <details class="card">
    <summary class="muted small">Edit name / student number</summary>
    <form method="post" action="/admin/students/<%= student.id %>/rename" class="mt">
      <label>Full name (kept private — used for matching)</label>
      <input type="text" name="name" value="<%= fullName(student) %>" />
      <label class="mt">Student number</label>
      <input type="text" name="studentNumber" value="<%= student.studentNumber || '' %>" />
      <div class="mt"><button class="btn small">Save</button></div>
    </form>
  </details>

  <% [1, 2].forEach(function (year) {
       var yearUnits = tree.filter(function (u) { return u.year === year && !u.exam; });
       var yearExams = examUnits.filter(function (e) { return e.year === year; });
       if (yearUnits.length === 0 && yearExams.length === 0) return;
  %>
    <h2 class="year-head">Year <%= year %></h2>

    <% yearExams.forEach(function (ex) { %>
      <section class="unit exam-unit">
        <h3><%= ex.name %> <span class="grade grade-X">Exam</span></h3>
        <p class="muted small">All students entered &amp; sat. <%= examInfo %></p>
      </section>
    <% }); %>

    <% yearUnits.forEach(function (unit) { %>
      <section class="unit" data-unit-id="<%= unit.id %>">
        <h3><%= unit.name %>
          <% if (unit.grade && unit.grade.grade) { %>
            <span class="grade grade-<%= unit.grade.grade %>" data-grade-for="<%= unit.id %>"><%= unit.grade.label %></span>
          <% } %>
        </h3>
        <% if (unit.assignments.every(function(a){ return a.criteria.length === 0; })) { %>
          <p class="muted">No criteria yet — add them in <a href="/admin/units">Units &amp; criteria</a>.</p>
        <% } %>
        <div class="assignments">
          <% unit.assignments.forEach(function (a) { %>
            <div class="assignment">
              <div class="assignment-name"><%= a.name %></div>
              <div class="criteria">
                <% a.criteria.forEach(function (c) { %>
                  <button type="button"
                          class="crit toggle <%= c.complete ? 'complete' : 'outstanding' %> type-<%= c.type.charAt(0) %>"
                          data-criterion-id="<%= c.id %>"
                          data-complete="<%= c.complete ? '1' : '0' %>"
                          title="<%= c.type %>"><%= c.code %></button>
                <% }); %>
                <% if (a.criteria.length === 0) { %><span class="muted small">(none)</span><% } %>
              </div>
            </div>
          <% }); %>
        </div>
      </section>
    <% }); %>
  <% }); %>

  <section class="card">
    <h2>Sharing</h2>
    <p class="muted">This student's private read-only link:</p>
    <div class="row gap wrap">
      <input class="share-link grow" type="text" readonly value="<%= baseUrl %>/s/<%= student.token %>" onclick="this.select()" />
      <button type="button" class="btn small" data-copy="<%= baseUrl %>/s/<%= student.token %>">Copy link</button>
      <a class="btn small" href="/s/<%= student.token %>" target="_blank" rel="noopener">Open</a>
    </div>
    <form method="post" action="/admin/students/<%= student.id %>/regenerate" class="mt"
          onsubmit="return confirm('Regenerate link? The old link will stop working.')">
      <button class="btn small danger">Regenerate link</button>
    </form>
  </section>
</main>

<script src="/static/app.js"></script>
<%- include('partials/foot') %>
